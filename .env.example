# Copy to .env.local (git-ignored). Never commit real keys. Everything here is optional: with no key the app runs and labels chat answers as offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma separated, tried in order if the main model is rate limited or unavailable.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Cap on Gemini calls per minute per server instance.
GEMINI_BUDGET_PER_MIN=40
